# VisionClick Agent Environment Variables
# Override config.yaml values via environment

# Browser
VISIONCLICK_HEADLESS=false
VISIONCLICK_SLOW_MO=0

# Agent
VISIONCLICK_DRY_RUN=true
VISIONCLICK_AUTO_SUBMIT=false
VISIONCLICK_MAX_TASKS=10
VISIONCLICK_MAX_RUNTIME_MINUTES=60

# Vision
VISIONCLICK_VISION_PROVIDER=mock

# Demo
VISIONCLICK_DEMO_URL=http://127.0.0.1:3000

# Dashboard
VISIONCLICK_DASHBOARD_HOST=127.0.0.1
VISIONCLICK_DASHBOARD_PORT=8000

# Database
VISIONCLICK_DB_PATH=./data/visionclick.db
